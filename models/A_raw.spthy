// Bounded observational-equivalence benchmark v2.5
// Query budget: two pre-challenge and two post-challenge decryption queries.
theory IND_CCA2_Adaptive_RAW
begin

builtins: hashing, asymmetric-encryption

rule Setup:
    [ Fr(~kid), Fr(~sk) ]
  --[ SetupDone(~kid) ]->
    [ !Ltk(~kid, ~sk)
    , Out(pk(~sk))
    , RawPhase(~kid, 'pre_make1')
    , RawHistA(~kid, h('ha0')), RawHistB(~kid, h('hb0'))
    , RawEpochA(~kid, 'ea0'), RawEpochB(~kid, 'eb0')
    , RawMarkA(~kid, 'ma0'), RawMarkB(~kid, 'mb0')
    , RawBudget(~kid, 'q0')
    ]


rule RegisterPre1:
    let c = aenc(<m, ~r>, pk(sk))
    in
    [ In(m), Fr(~r), !Ltk(kid, sk)
    , RawPhase(kid, 'pre_make1')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q0')
    ]
  --[ CiphertextRegistered(kid, 'pre1', c) ]->
    [ Out(c), !DecEntry(kid, 'pre1', c, m)
    , RawPhase(kid, 'pre_dec1')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q0')
    ]

rule DecryptPre1:
    [ In(c), !DecEntry(kid, 'pre1', c, m)
    , RawPhase(kid, 'pre_dec1')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q0')
    ]
  --[ PreOracleQuery(kid, 'pre1', c) ]->
    [ Out(m)
    , RawPhase(kid, 'pre_make2')
    , RawHistA(kid, h(<ha,'pre1'>)), RawHistB(kid, h(<hb,'pre1'>))
    , RawEpochA(kid, h(<ea,'step'>)), RawEpochB(kid, h(<eb,'step'>))
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q1')
    ]


rule RegisterPre2:
    let c = aenc(<m, ~r>, pk(sk))
    in
    [ In(m), Fr(~r), !Ltk(kid, sk)
    , RawPhase(kid, 'pre_make2')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q1')
    ]
  --[ CiphertextRegistered(kid, 'pre2', c) ]->
    [ Out(c), !DecEntry(kid, 'pre2', c, m)
    , RawPhase(kid, 'pre_dec2')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q1')
    ]

rule DecryptPre2:
    [ In(c), !DecEntry(kid, 'pre2', c, m)
    , RawPhase(kid, 'pre_dec2')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q1')
    ]
  --[ PreOracleQuery(kid, 'pre2', c) ]->
    [ Out(m)
    , RawPhase(kid, 'challenge')
    , RawHistA(kid, h(<ha,'pre2'>)), RawHistB(kid, h(<hb,'pre2'>))
    , RawEpochA(kid, h(<ea,'step'>)), RawEpochB(kid, h(<eb,'step'>))
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q2')
    ]


rule IssueChallenge:
    let c_star = aenc(<diff(m0, m1), ~r_star>, pk(sk))
    in
    [ In(<m0,m1>), Fr(~r_star), !Ltk(kid, sk)
    , RawPhase(kid, 'challenge')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q2')
    ]
  --[ ChallengeIssued(kid, c_star) ]->
    [ Out(c_star)
    , RawPhase(kid, 'post_make1')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, h(<ea,'challenge'>)), RawEpochB(kid, h(<eb,'challenge'>))
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q2')
    ]


rule RegisterPost1:
    let c = aenc(<m, ~r>, pk(sk))
    in
    [ In(m), Fr(~r), !Ltk(kid, sk)
    , RawPhase(kid, 'post_make1')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q2')
    ]
  --[ CiphertextRegistered(kid, 'post1', c) ]->
    [ Out(c), !DecEntry(kid, 'post1', c, m)
    , RawPhase(kid, 'post_dec1')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q2')
    ]

rule DecryptPost1:
    [ In(c), !DecEntry(kid, 'post1', c, m)
    , RawPhase(kid, 'post_dec1')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q2')
    ]
  --[ PostOracleQuery(kid, 'post1', c) ]->
    [ Out(m)
    , RawPhase(kid, 'post_make2')
    , RawHistA(kid, h(<ha,'post1'>)), RawHistB(kid, h(<hb,'post1'>))
    , RawEpochA(kid, h(<ea,'step'>)), RawEpochB(kid, h(<eb,'step'>))
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q3')
    ]


rule RegisterPost2:
    let c = aenc(<m, ~r>, pk(sk))
    in
    [ In(m), Fr(~r), !Ltk(kid, sk)
    , RawPhase(kid, 'post_make2')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q3')
    ]
  --[ CiphertextRegistered(kid, 'post2', c) ]->
    [ Out(c), !DecEntry(kid, 'post2', c, m)
    , RawPhase(kid, 'post_dec2')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q3')
    ]

rule DecryptPost2:
    [ In(c), !DecEntry(kid, 'post2', c, m)
    , RawPhase(kid, 'post_dec2')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q3')
    ]
  --[ PostOracleQuery(kid, 'post2', c) ]->
    [ Out(m)
    , RawPhase(kid, 'finish')
    , RawHistA(kid, h(<ha,'post2'>)), RawHistB(kid, h(<hb,'post2'>))
    , RawEpochA(kid, h(<ea,'step'>)), RawEpochB(kid, h(<eb,'step'>))
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q4')
    ]


rule Finish:
    [ In('finish')
    , RawPhase(kid, 'finish')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q4')
    ]
  --[ Finished(kid) ]->
    [ Out('done')
    , RawPhase(kid, 'done')
    , RawHistA(kid, ha), RawHistB(kid, hb)
    , RawEpochA(kid, ea), RawEpochB(kid, eb)
    , RawMarkA(kid, ma), RawMarkB(kid, mb)
    , RawBudget(kid, 'q4')
    ]

end
